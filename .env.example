# Copy to .env.local and fill in. Set the same variables in Vercel → Project → Settings → Environment Variables.

# Clerk → your application → Configure → API keys (development instance)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase → Project Settings → API Keys. Server-only: no NEXT_PUBLIC_ prefix, and never the secret/service_role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# TMDB → Settings → API → "API Read Access Token" (the long v4 token, not the short API Key)
TMDB_READ_ACCESS_TOKEN=

# Tests only: answer TMDB from tests/fixtures/tmdb/ instead of the network (the Playwright web server sets it)
# TMDB_FIXTURES=1
